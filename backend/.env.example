# CodeLens AI — Backend Environment Variables
# Copy this file to .env and fill in your keys before starting the server.

# Required: OpenRouter API key — get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional but recommended: GitHub Personal Access Token
# Without this you are limited to 60 unauthenticated requests/hr.
# With a token the limit is 5 000 req/hr.
# Create one at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here

# CORS: comma-separated list of frontend URLs allowed to call this API.
# Add your Cloudflare Pages URL here after deploying the frontend.
# Example: ALLOWED_ORIGINS=https://codelens-ai.pages.dev,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
